# Token Myths — environment variables.
# Copy to .env and fill in real values — .env is gitignored, never commit it.

# GlitchTip error tracking (Sentry-compatible, self-hosted).
# Create a project in GlitchTip and paste its DSN here; the SDK reads this at
# startup, so the first build ships errors without further wiring.
GLITCHTIP_DSN=

# Plausible analytics (privacy-friendly, self-hosted).
# Set to the Plausible instance domain (e.g. analytics.devprocore.com).
# The frontend build injects the tracking script only when this is set —
# no-op in local dev, just like GLITCHTIP_DSN.
VITE_PLAUSIBLE_DOMAIN=